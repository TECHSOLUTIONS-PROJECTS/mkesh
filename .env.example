# ---------------------------------------------------------------------------
# MKESH / PagamKesh (Ericsson EWP Aggregator) credentials
# ---------------------------------------------------------------------------

# HTTP Basic auth (provided by the aggregator, base64-encoded by the SDK)
MKESH_USERNAME=
MKESH_PASSWORD=

# FRI credited when you debit a customer (C2B), e.g. FRI:pagamKesh/USER
MKESH_SP_FRI=FRI:pagamKesh/USER

# Wallet money leaves from on a B2C payout (sptransfer), e.g. FRI:47225552/MM.
# Leave empty to reuse MKESH_SP_FRI.
MKESH_SP_TRANSFER_FRI=

# Aggregator host
MKESH_BASE_URL=https://41.220.193.151

# Currency applied to amounts when not given explicitly
MKESH_CURRENCY=MZN

# Mandatory prefix the aggregator requires on externaltransactionid /
# referenceid. The SDK prepends it automatically (e.g. MTL000001).
MKESH_TRANSACTION_PREFIX=

# Endpoint that receives debitcompletedrequest. Register this URL with the
# provider — it is configured on their side, not sent with each request.
MKESH_CALLBACK_URL=https://your-app.example/mkesh/callback

# Emit <callbackurl> inside debitrequest. Off by default: the documented
# payload has no such element. Only enable if the provider confirms support.
MKESH_SEND_CALLBACK_URL=false

# ---------------------------------------------------------------------------
# TLS verification
# The aggregator is published on a bare IP, so its certificate will not match
# the host name. Point MKESH_SSL_CA_BUNDLE at the certificate the provider
# gives you; only disable verification against the sandbox.
# ---------------------------------------------------------------------------
MKESH_VERIFY_SSL=true
MKESH_SSL_CA_BUNDLE=

# Per-request timeout (seconds)
MKESH_TIMEOUT=30

# ---------------------------------------------------------------------------
# Endpoint paths (override only if your aggregator differs)
# ---------------------------------------------------------------------------
MKESH_DEBIT_PATH=/DebitServlet/DebitSvlt
MKESH_SP_TRANSFER_PATH=/sptransfer/sptransfer
MKESH_STATUS_PATH=/GetTransactionStatus/GetStatusSvlt
