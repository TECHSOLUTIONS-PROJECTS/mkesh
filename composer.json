{
    "name": "techsolutions/mkesh",
    "description": "PHP package for the MKESH (PagamKesh) mobile money integration over the Ericsson EWP Aggregator (XML over HTTP), with first-class Laravel support.",
    "keywords": ["mkesh", "pagamkesh", "mobile-money", "ericsson", "ewp", "mozambique", "payments", "laravel"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/TECHSOLUTIONS-PROJECTS/mkesh",
    "authors": [
        {
            "name": "TechSolutions",
            "email": "info@techsolutions.co.mz",
            "homepage": "https://github.com/TECHSOLUTIONS-PROJECTS",
            "role": "Owner"
        },
        {
            "name": "Osvaldo Geraldo Manjate",
            "email": "osvaldogeraldo34@gmail.com",
            "homepage": "https://github.com/osvaldogeraldo",
            "role": "Developer @ TechSolutions"
        }
    ],
    "support": {
        "email": "it@techsolutions.co.mz",
        "issues": "https://github.com/TECHSOLUTIONS-PROJECTS/mkesh/issues",
        "source": "https://github.com/TECHSOLUTIONS-PROJECTS/mkesh"
    },
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel ServiceProvider and Mkesh facade."
    },
    "autoload": {
        "psr-4": {
            "TechSolutions\\Mkesh\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TechSolutions\\Mkesh\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TechSolutions\\Mkesh\\Laravel\\MkeshServiceProvider"
            ],
            "aliases": {
                "Mkesh": "TechSolutions\\Mkesh\\Laravel\\Facades\\Mkesh"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
